{
  "name": "jobscrapper",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "jobscrapper",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "apps/cli": {
      "name": "@jobscrapper/cli",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@jobscrapper/config": "*",
        "@jobscrapper/core": "*",
        "@jobscrapper/sources": "*",
        "@jobscrapper/storage": "*"
      },
      "bin": {
        "jobscrapper": "index.js"
      }
    },
    "node_modules/@jobscrapper/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@jobscrapper/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@jobscrapper/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@jobscrapper/sources": {
      "resolved": "packages/sources",
      "link": true
    },
    "node_modules/@jobscrapper/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "packages/config": {
      "name": "@jobscrapper/config",
      "version": "1.0.0",
      "license": "MIT"
    },
    "packages/core": {
      "name": "@jobscrapper/core",
      "version": "1.0.0",
      "license": "MIT"
    },
    "packages/sources": {
      "name": "@jobscrapper/sources",
      "version": "1.0.0",
      "license": "MIT",
      "dependencies": {
        "@jobscrapper/core": "*"
      }
    },
    "packages/storage": {
      "name": "@jobscrapper/storage",
      "version": "1.0.0",
      "license": "MIT"
    }
  }
}
